# Required for direct Google Sheets synchronization.
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Optional; provide comma-separated JobSpy-compatible proxy URLs if needed.
JOBSPY_PROXIES=

# ==============================================================================
# Multi-Key Rotating LLM Pool (Automatic failover on 429/quota exhaustion)
# ==============================================================================
# GROQ KEYS (Rotates 1 -> 2 -> 3)
GROQ_API_KEY1=gsk_...
GROQ_API_KEY2=gsk_...
GROQ_API_KEY3=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# OPENROUTER KEYS (Rotates 1 -> 2 -> 3 when Groq is exhausted)
OPENROUTER_API_KEY1=sk-or-v1-...
OPENROUTER_API_KEY2=sk-or-v1-...
OPENROUTER_API_KEY3=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
